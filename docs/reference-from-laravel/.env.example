# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="NSK Computer Zone"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.nskcomputerzone.in
APP_VERSION=1.0.0
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

# Frontend origin — used for CORS, Sanctum and links in emails.
FRONTEND_URL=https://www.nskcomputerzone.in
ADMIN_URL=https://www.nskcomputerzone.in
SALES_PHONE="+91 98765 43210"
WHATSAPP_URL=https://wa.me/919876543210

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nsk_computer_zone
DB_USERNAME=nsk_app
DB_PASSWORD=

# ─── Sanctum / session ───────────────────────────────────────────────────────
# Must include every host the SPA is served from, or cookie auth silently fails.
SANCTUM_STATEFUL_DOMAINS=www.nskcomputerzone.in,nskcomputerzone.in,localhost:3000
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.nskcomputerzone.in

# ─── Cache / queue ───────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@nskcomputerzone.in
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SALES_ADDRESS=sales@nskcomputerzone.in

# ─── Object storage (Cloudflare R2 — S3-compatible) ──────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=nsk-computer-zone-media
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_URL=https://cdn.nskcomputerzone.in
AWS_USE_PATH_STYLE_ENDPOINT=true

# ─── AI assistant ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DAILY_TOKEN_BUDGET=2000000

# ─── First admin (seeding only; remove after the first deploy) ───────────────
ADMIN_NAME="Karthik Menon"
ADMIN_EMAIL=admin@nskcomputerzone.in
ADMIN_PASSWORD=

# ─── Observability ───────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=
