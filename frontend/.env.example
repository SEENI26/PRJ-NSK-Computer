# Public origin. Used for canonical links, og:image and the generated
# sitemap. Leave blank in development — the browser origin is used instead.
VITE_SITE_URL=

# Google Maps embed key. Without it the contact page renders a styled address
# panel and a directions link instead of an iframe.
VITE_GOOGLE_MAPS_KEY=

# PHP enquiry API. Leave blank to disable form submission; in development the
# Vite proxy handles /api, so "" is correct locally.
VITE_API_BASE_URL=

# Shown on the contact page and in the mobile menu.
VITE_WHATSAPP_NUMBER=919791430774
VITE_CONTACT_EMAIL=nskcomputer@gmail.com
VITE_COMPANY_PHONE=+919791430774
